# Values baked into the build. Committed on purpose: none of these are secret.
# NEXT_PUBLIC_* is inlined at build time, so it must be correct when you run
# `npm run build` on your own machine — the server cannot change it later.
#
# RECAPTCHA_SECRET_KEY is deliberately absent. It is read at runtime and lives
# only in cPanel's Environment variables.
WP_URL=https://wp.agfasgas.com
NEXT_PUBLIC_WP_URL=https://wp.agfasgas.com
SITE_URL=https://agfasgas.com
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lc_IJEtAAAAALPFdzBdWF_mXlB3JRms6PvZfj9Q
