# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
# The build output is committed: this host cannot run "next build" (its 4 GB
# address-space cap rejects the WebAssembly the compiler needs), so the built
# site is deployed rather than built on the server.
.next/cache/
.next/dev/
.next/trace
# Next rewrites its prerendered output whenever an ISR page revalidates. Tracking
# those files makes the server dirty within a minute of starting, and the next
# "git pull" aborts rather than overwrite them. They are regenerated on demand
# when absent, so the deploy does not need them.
.next/server/app/**/*.html
.next/server/app/**/*.rsc
.next/server/app/**/*.body
.next/server/app/**/*.meta
# /.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example
!.env.production
